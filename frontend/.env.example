# Frontend server runtime environment
# These values are read by server.js through process.env and are not exposed to browser code.

# Optional: override the Express server port.
# Defaults to 5173 for HTTP and 443 when SSL_CERT_PATH/SSL_KEY_PATH are set.
PORT=

# Optional: enable HTTPS directly in the frontend server.
# Production HAProxy backend SSL expects the app to be reachable over HTTPS.
SSL_CERT_PATH=
SSL_KEY_PATH=

# Backend service targets used by the frontend server proxy.
# These are server-side URLs and should not use the VITE_ prefix.
PRESETS_TARGET=http://localhost:8005
CONFIG_TARGET=http://localhost:8004
CONTROL_TARGET=http://localhost:8003

# Browser-visible Vite environment
# Any VITE_ value may be embedded in the client bundle. Do not put secrets here.

# Direct-control/Ophyd API URL passed to Finch client components.
VITE_API_URL=http://localhost:8003/api/v1
